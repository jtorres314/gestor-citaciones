rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper Primitives
    function isSignedIn() { return request.auth != null; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }

    // Validation Helper
    function isValidCitacion(data) {
      return data.nombre is string && data.nombre.size() > 0 && data.nombre.size() <= 200 &&
             data.orden is string && data.orden.size() <= 100 &&
             data.fecha is string && data.fecha.size() <= 50 &&
             data.hora is string && data.hora.size() <= 30;
    }

    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // User Profile block
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create, update: if isOwner(userId);
    }

    // Historial match block
    match /artifacts/citaciones-judiciales-app/users/{userId}/historial/{citationId} {
      allow list: if isOwner(userId);
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidId(citationId) && isValidCitacion(incoming());
      allow update: if isOwner(userId) && isValidCitacion(incoming());
      allow delete: if isOwner(userId);
    }
  }
}
